# ==========================================
# ArchiveX Environment Configuration Template
# ==========================================

# Operational Mode (True for synthetic enterprise demo data, False for live AWS S3)
DEMO_MODE=True

# AWS Authentication (Optional if running in Demo Mode or using AWS IAM Roles / ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Optional AI Augmentation for ArchiveX Copilot
# If left blank, ArchiveX uses the deterministic "Rule-based Archive Assistant"
GEMINI_API_KEY=
OPENAI_API_KEY=
